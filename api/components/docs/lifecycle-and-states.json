      "ETB_CONFIRMED",
      "NTB_CONFIRMED"
    ],
    "ETB_CONFIRMED": [
      "PAYMENT_PENDING"
    ],
    "NTB_CONFIRMED": [
      "KYC_PENDING"
    ],
    "KYC_PENDING": [
      "KYC_COMPLETED",
      "KYC_FAILED"
    ],
    "KYC_COMPLETED": [
