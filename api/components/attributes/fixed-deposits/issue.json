{
  "title": "ONDC FIS FD — issue Attributes",
  "domain": "ONDC:FIS:FD",
  "version": "1.0.0",
  "beckn_version": "2.0.0",
  "action": "issue",
  "direction": "BAP → BPP",
  "purpose": "Grievance Management (IGM) — routed to issuer and tracked until resolution per BRD",
