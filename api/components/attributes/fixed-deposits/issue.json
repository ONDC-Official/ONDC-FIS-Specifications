  "context": {
    "location": {
      "country": {
        "code": {
          "required": "mandatory",
          "type": "string",
          "owner": "BAP",
          "usage": "IND",
          "description": "Country code ISO 3166. Use IND for India."
        }
      },
      "city": {
        "code": {
          "required": "mandatory",
          "type": "string",
          "owner": "BAP",
          "usage": "*",
          "description": "FD is location-agnostic; use *"
        }
      }
    },
    "domain": {
      "required": "mandatory",
      "type": "string",
      "owner": "BAP",
      "usage": "ONDC:FIS:FD"
    },
    "version": {
      "required": "mandatory",
      "type": "string",
      "owner": "BAP",
      "usage": "2.0.0",
      "description": "Beckn protocol version"
    },
    "action": {
      "required": "mandatory",
      "type": "string",
      "owner": "BAP",
      "usage": "issue"
    },
    "timestamp": {
      "required": "mandatory",
      "type": "string",
      "owner": "BAP",
      "description": "RFC3339 timestamp"
    },
    "bap_id": {
      "required": "mandatory",
      "type": "string",
      "owner": "BAP"
    },
    "bap_uri": {
      "required": "mandatory",
      "type": "string",
      "owner": "BAP"
    },
    "transaction_id": {
      "required": "mandatory",
      "type": "string",
      "owner": "BAP",
      "description": "Correlation ID for the transaction journey"
    },
    "message_id": {
      "required": "mandatory",
      "type": "string",
      "owner": "BAP",
      "description": "Correlation ID for this request/response"
    },
    "bpp_id": {
      "required": "mandatory",
      "type": "string",
      "owner": "BPP"
    },
    "bpp_uri": {
      "required": "mandatory",
      "type": "string",
      "owner": "BPP"
    },
    "ttl": {
      "required": "optional",
      "type": "string",
      "owner": "BAP",
      "usage": "PT30S"
    }
  },
  "message": {
    "issue": {
      "ref_id": {
        "required": "mandatory",
        "type": "string",
        "owner": "BAP",
        "beckn_path": "message.issue.ref_id",
        "error_codes": [
          823015
        ]
      },
      "category": {
        "required": "mandatory",
        "type": "string",
        "owner": "BAP",
        "usage": "PAYMENT",
        "description": "Grievance category e.g. PAYMENT, KYC, BOOKING, WITHDRAWAL, DOCUMENT",
        "beckn_path": "message.issue.category"
      },
      "description": {
        "required": "mandatory",
        "type": "string",
        "owner": "BAP",
        "beckn_path": "message.issue.description"
      },
      "complainant": {
        "contact": {
          "phone": {
            "required": "mandatory",
            "type": "string",
            "owner": "BAP",
            "usage": "9876543210",
