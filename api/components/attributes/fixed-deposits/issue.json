          }
        }
      },
      "tags": {
        "IGM": {
          "list": {
            "IGM_COMPLIANT": {
              "required": "mandatory",
              "type": "boolean",
              "owner": "BAP",
              "usage": "true"
            }
          }
        }
      }
    }
