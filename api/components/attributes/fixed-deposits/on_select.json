          "time": {
            "timestamp": {
              "required": "optional",
              "type": "string",
              "owner": "BPP",
              "usage": "2027-08-20T00:00:00.000Z",
              "format": "DD-MM-YYYY",
              "beckn_path": "message.order.fulfillment.end.time.timestamp"
            }
          }
        }
      }
