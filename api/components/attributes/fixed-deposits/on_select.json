          "FD_TERMS": {
            "list": {
              "DEPOSIT_AMOUNT": {
                "required": "mandatory",
                "type": "number",
                "owner": "BPP",
                "usage": "7.25",
                "beckn_path": "message.order.quote.price.value",
                "tag_code": "DEPOSIT_AMOUNT",
                "error_codes": [
                  823004,
                  823013
                ]
              },
              "PAYOUT_MODE": {
                "required": "mandatory",
                "type": "enum",
                "owner": "BPP",
                "usage": "CUMULATIVE",
                "enum": [
                  "CUMULATIVE",
                  "NON_CUMULATIVE"
                ],
                "beckn_path": "message.order.items[].tags[PAYOUT_MODE]",
                "tag_code": "PAYOUT_MODE"
              },
              "MATURITY_INSTRUCTION": {
                "required": "mandatory",
                "type": "enum",
                "owner": "BPP",
                "usage": "--",
                "beckn_path": "message.order.items[].tags[MATURITY_INSTRUCTION]",
                "tag_code": "MATURITY_INSTRUCTION",
                "error_codes": [
                  823025
                ]
              }
            }
          }
        }
      },
      "quote": {
        "price": {
          "value": {
            "required": "mandatory",
            "type": "number",
            "owner": "BPP",
            "usage": "100000",
            "beckn_path": "message.order.quote.price.value"
          }
