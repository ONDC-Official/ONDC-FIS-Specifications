  "beckn_nack_format": {
    "description": "BPP returns NACK in callback with numeric error code in message.error",
    "example": {
      "message": {
        "ack": {
          "status": "NACK"
        },
        "error": {
          "type": "DOMAIN-ERROR",
          "code": "823001",
          "message": "Investor not supported — v1 accepts INDIVIDUAL_RESIDENT only"
        }
      }
    }
  },
